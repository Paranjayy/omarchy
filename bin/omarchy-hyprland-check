#!/bin/bash
# omarchy:group=hyprland
# omarchy:name=check
# omarchy:summary=Validate the isolated Omarchy Hyprland profile

set -u

config="$HOME/.config/hypr/hyprland.conf"
failed=0

if [[ ! -e "$config" ]]; then
  printf 'MISSING: %s\n' "$config" >&2
  failed=1
fi

session_found=false
for session in \
  "$HOME/.local/share/wayland-sessions/omarchy-profile.desktop" \
  "/usr/local/share/wayland-sessions/omarchy-profile.desktop"; do
  if [[ -e "$session" ]]; then
    session_found=true
    break
  fi
done
if [[ $session_found != true ]]; then
  printf 'MISSING: Omarchy profile session entry\n' >&2
  failed=1
fi

launcher_found=false
for launcher in \
  "$HOME/.local/bin/omarchy-hyprland-session" \
  "/usr/local/bin/omarchy-hyprland-session"; do
  if [[ -x "$launcher" ]]; then
    launcher_found=true
    break
  fi
done
if [[ $launcher_found != true ]]; then
  printf 'MISSING: Omarchy profile launcher\n' >&2
  failed=1
fi

if (( failed )); then
  exit 1
fi

if ! Hyprland -c "$config" --verify-config; then
  printf 'FAILED: Hyprland rejected %s\n' "$config" >&2
  exit 1
fi

printf 'OK: Omarchy config, launcher, and selectable session are ready.\n'
