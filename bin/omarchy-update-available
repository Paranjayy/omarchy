#!/bin/bash

# omarchy:summary=Check for updates on the active Omarchy source

set -euo pipefail

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Omarchy source is package-managed; use the normal package updater."
  exit 1
fi

remote="${OMARCHY_UPDATE_REMOTE:-origin}"
branch=$(git -C "$OMARCHY_PATH" branch --show-current)
if [[ -z $branch ]]; then
  echo "Omarchy source is detached; refusing to guess an update branch." >&2
  exit 2
fi

git -C "$OMARCHY_PATH" fetch --quiet "$remote" "$branch"
local_commit=$(git -C "$OMARCHY_PATH" rev-parse HEAD)
remote_commit=$(git -C "$OMARCHY_PATH" rev-parse "$remote/$branch")

if [[ $local_commit != "$remote_commit" ]]; then
  echo "Omarchy update available on $remote/$branch"
  git -C "$OMARCHY_PATH" --no-pager log --oneline "$local_commit..$remote_commit" | head -20
  exit 0
fi

echo "Omarchy source is up to date ($branch @ ${local_commit:0:8})"
exit 1
